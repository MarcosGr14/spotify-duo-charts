SPOTIFY_CLIENT_ID=tu_client_id_aqui
SPOTIFY_CLIENT_SECRET=tu_client_secret_aqui
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback
DATABASE_URL=postgres://usuario:password@localhost:5432/spotify_charts
ENCRYPTION_KEY=generar_con_el_comando_del_readme
# Cuentas adicionales autorizadas (las cuentas existentes se permiten siempre)
SPOTIFY_ALLOWED_USER_IDS=
# public conserva el sitio actual; private exige usuario duo y SITE_PASSWORD
SITE_VISIBILITY=public
SITE_PASSWORD=
# Credenciales de backup: guardar en GitHub Secrets, nunca en el repositorio
BACKUP_DATABASE_URL=
BACKUP_PASSPHRASE=
RESTORE_TEST_DATABASE_URL=
